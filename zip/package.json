{
  "name": "Mogogosiek-AutoSpares-POS",
  "version": "0.2.3",
  "author": "Benard Kiplangat",
  "description": "POS application for an Autospares Shop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir \"C:\\Users\\Ben\\Documents\\imara-auto-spares-pos\\pos\"",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "electron-builder",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5000 && electron .\"",
    "start:electron": "electron ."
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^13.0.2",
    "events": "^3.3.0",
    "express": "^5.2.1",
    "jspdf": "^3.0.1",
    "node-gyp": "^13.0.1",
    "pouchdb": "^7.3.0",
    "pouchdb-browser": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.5.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.0.0",
    "vite": "^4.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
  "appId": "com.ben.imaraautospares",
  "productName": "Imara Auto Spares POS",

  "files": [
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],

  "directories": {
    "output": "dist"
  },

  "win": {
    "target": "nsis",
    "icon": "electron/assets/icon.ico"
  },

  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "electron/assets/icon.ico",
    "uninstallerIcon": "electron/assets/icon.ico"
  }
}
}
